# Plantilla de entorno (raiz)
# Copia este archivo a .env y completa los valores.
# NO subir .env a Git.
#
# Tambien puedes usar:
#   CLONACION_CARPETA/.env
#   LMS_Fabrica/.env

# Destinatarios de los correos (clon y carga GCP), separados por coma.
CORREOS_AVISO=correo1@cun.edu.co,correo2@cun.edu.co

# Conexion a Cloud SQL (solo hace falta para LMS_Fabrica / cargar_base_gcp.py)
DB_HOST=
DB_PORT=5432
DB_NAME=planner_db
DB_USER=
DB_PASSWORD=

# Esquema de trabajo. Prueba = fabrica_pruebas. Produccion = fabrica.
LMS_SCHEMA=fabrica_pruebas
